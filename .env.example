# Firebase Web App configuration
# Create a Firebase project, enable Authentication (Google + Email/Password),
# register a Web App, then copy its config values here.
# In GitHub Actions, add the same values as repository secrets named
# VITE_FIREBASE_API_KEY, VITE_FIREBASE_AUTH_DOMAIN,
# VITE_FIREBASE_PROJECT_ID and VITE_FIREBASE_APP_ID.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
