
:root {
  color-scheme: light;
  --sl-primary: #2563eb;
  --sl-primary-hover: #1d4ed8;
  --sl-primary-soft: #eff6ff;
  --sl-bg: #f4f6fa;
  --sl-surface: #ffffff;
  --sl-surface-muted: #f8fafc;
  --sl-text: #172033;
  --sl-text-muted: #64748b;
  --sl-border: #e2e8f0;
  --sl-success: #15803d;
  --sl-danger: #dc2626;
  --sl-warning: #d97706;
  --sl-radius: 14px;
  --sl-shadow: 0 4px 18px rgba(15, 23, 42, .045);
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}
html { background: var(--sl-bg); }
body {
  background: var(--sl-bg);
  color: var(--sl-text);
  font-family: inherit;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}
button, input, select, textarea { font: inherit; }
button { transition: background-color .18s ease, border-color .18s ease, color .18s ease, box-shadow .18s ease, transform .18s ease; }
button:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-visible {
  outline: 3px solid rgba(37, 99, 235, .22);
  outline-offset: 2px;
}
input, select, textarea {
  border-color: var(--sl-border);
  border-radius: 10px;
}
table { border-collapse: separate; border-spacing: 0; }
th { color: var(--sl-text-muted); font-weight: 600; }
td, th { vertical-align: middle; }
::selection { background: #dbeafe; color: #1e3a8a; }
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { scroll-behavior: auto !important; transition-duration: .01ms !important; animation-duration: .01ms !important; }
}

/* SmartLedger Premium Component System */
#root {
  min-height: 100vh;
  background: var(--sl-bg);
}

#root .bg-white {
  background-color: var(--sl-surface);
}

#root .rounded-xl {
  border-radius: var(--sl-radius);
}

#root .shadow-sm {
  box-shadow: var(--sl-shadow);
}

#root .border-gray-100,
#root .border-gray-200 {
  border-color: var(--sl-border);
}

#root .text-gray-500,
#root .text-gray-600 {
  color: var(--sl-text-muted);
}

#root input:not([type="checkbox"]):not([type="radio"]):not([type="file"]),
#root select,
#root textarea {
  min-height: 42px;
  padding: 9px 12px;
  background: var(--sl-surface);
  color: var(--sl-text);
  border: 1px solid var(--sl-border);
  border-radius: 10px;
  transition: border-color .18s ease, box-shadow .18s ease;
}

#root input:focus,
#root select:focus,
#root textarea:focus {
  border-color: var(--sl-primary);
  box-shadow: 0 0 0 3px rgba(37, 99, 235, .10);
  outline: none;
}

#root button {
  border-radius: 10px;
  font-weight: 600;
}

#root button:active {
  transform: scale(.98);
}

#root table {
  width: 100%;
  font-size: 13px;
}

#root thead th {
  background: var(--sl-surface-muted);
  padding: 12px;
  white-space: nowrap;
  border-bottom: 1px solid var(--sl-border);
}

#root tbody td {
  padding: 12px;
  border-bottom: 1px solid var(--sl-border);
}

#root tbody tr:last-child td {
  border-bottom: 0;
}

#root tbody tr:hover {
  background: #f8fafc;
}

#root h1 {
  letter-spacing: -.035em;
  font-weight: 750;
}

#root h2, #root h3 {
  letter-spacing: -.02em;
  font-weight: 700;
}

@media (max-width: 640px) {
  #root {
    overflow-x: hidden;
  }
  #root .overflow-x-auto {
    -webkit-overflow-scrolling: touch;
  }
  #root .rounded-xl {
    border-radius: 12px;
  }
  #root button {
    min-height: 40px;
  }
}

/* SmartLedger Dark Theme */
